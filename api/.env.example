DATABASE_URL=postgres://app:app@db:5432/app

# IA : un modèle qui tourne chez nous, jamais d'API externe (voir docs/adr/0002-fournisseur-ia.md)
# N'importe quel serveur compatible OpenAI fonctionne : seules ces 3 lignes changent.

# Par défaut - Ollama installé sur la machine hôte (ollama pull llama3.2:3b)
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2:3b
AI_API_KEY=ollama

# Plus tard - le modèle servi par l'équipe data (même format)
# AI_BASE_URL=http://<machine-du-data>:<port>/v1
# AI_MODEL=<nom-du-modele>
# AI_API_KEY=<cle-d-acces-du-service>

# Ancienne option, abandonnée (IA externe) - gardée pour mémoire
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-lite-latest

# Service data (FastAPI de l'équipe data, dossier rag/)
# URL du service : en local http://localhost:8000, via un tunnel l'URL ngrok fournie par l'équipe data
DATA_API_URL=
# Clé d'accès si le service en exige une (obligatoire dès qu'il est exposé publiquement)
DATA_API_KEY=
