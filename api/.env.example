DATABASE_URL=postgres://app:app@db:5432/app

# IA : n'importe quelle API compatible OpenAI

# Option 1 - Google Gemini (par defaut, tier gratuit sans carte bancaire)
# cle sur https://aistudio.google.com/app/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
AI_API_KEY=

# Option 2 - Mistral (cles API inactives sur le plan Free, il faut le plan Experiment)
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=mistral-small-latest
# AI_API_KEY=

# Option 3 - Hugging Face Inference Providers (token avec "Make calls to Inference Providers")
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_MODEL=meta-llama/Llama-3.3-70B-Instruct
# AI_API_KEY=

# Option 4 - Ollama sur le Mac (ollama pull llama3.2:1b)
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=llama3.2:1b
# AI_API_KEY=ollama
