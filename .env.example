# Copier en .env puis remplacer les valeurs. Valeurs factices uniquement.

# Base PostgreSQL (docker compose)
POSTGRES_USER=trendpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trendpulse
DATABASE_URL=postgresql+psycopg://trendpulse:change-me@db:5432/trendpulse

# Cle exigee dans l'en-tete X-API-Key (l'API est exposee par ngrok)
API_KEY=replace-with-a-long-random-string

# Adresse publique du projet (depot ou page) ajoutee au User-Agent generique.
# Jamais d'e-mail personnel (RG21).
PROJECT_URL=https://example.org/trendpulse

# Cle OpenAlex (recherche_academique). Vide : source "indisponible", jamais zero.
OPENALEX_API_KEY=

# Sources actives, separees par des virgules. Reddit desactive par defaut (RG16).
ENABLED_SOURCES=google_trends,wikipedia_pageviews,gdelt,open_food_facts,open_beauty_facts,fragrance_seed,openalex,rss_trade_press,csv_import

# Marches suivis (codes ISO 3166-1 alpha-2)
MARKETS=FR,US,GB,DE,JP,KR

# LLM local sur l'hote
LLM_ENABLED=true
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:1.5b

# Agent en lecture seule (RG17). Modele separe. Le role agent_ro est cree par
# "python run.py db-upgrade" si AGENT_DB_PASSWORD est fourni.
AGENT_LLM_MODEL=qwen2.5:1.5b
AGENT_DB_PASSWORD=change-me-too
AGENT_DATABASE_URL=postgresql+psycopg://agent_ro:change-me-too@db:5432/trendpulse

# Webhook compatible Slack (RG32). dry_run par defaut : rien n'est envoye.
WEBHOOK_URL=
WEBHOOK_DRY_RUN=true

# Embeddings Ollama pour la decouverte de candidats (RG28), optionnel
EMBED_MODEL=nomic-embed-text
